# ==============================================================================
# Dockerfile.gpu — Production GPU Container for Florence-2 Vision Service
# ==============================================================================
FROM nvidia/cuda:12.1.1-runtime-ubuntu22.04

LABEL maintainer="Florence-2 Vision Team"
LABEL description="Production GPU Container for Florence-2 Commercial Vision Service"
LABEL license="MIT"

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-dev \
    curl \
    git \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy requirements and install Python dependencies
COPY requirements.txt .
RUN pip3 install --no-cache-dir -r requirements.txt

# Pre-download Florence-2 model weights during image build for fast cold-start
COPY scripts/download_florence2.py scripts/
RUN python3 scripts/download_florence2.py

# Copy application source code
COPY integration/ ./integration/
COPY scripts/ ./scripts/
COPY sdk/ ./sdk/
COPY benchmarks/media/ ./benchmarks/media/
COPY tests/fixtures/ ./tests/fixtures/

# Expose Load Balancer (8080) and Worker (8081)
EXPOSE 8080 8081

# Default environment variables
ENV FLORENCE_MODEL_ID="microsoft/Florence-2-large"
ENV FLORENCE_PORT=8081
ENV CLUSTER_WORKERS="Florence2-GPU:http://127.0.0.1:8081:gpu"
ENV AUTH_ENABLED="false"
ENV RATE_LIMIT_RPM=120

# Run entrypoint script
CMD ["bash", "scripts/run_cluster_daemon.sh"]
